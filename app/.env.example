# Copy this file to ".env" and fill in real values there.
# NEVER commit a real .env, and never put real secrets in this example file.

# Port the server listens on
PORT=3000

# true  = Pi Testnet / Staging app (Pi Sandbox, Test-Pi)
# false = Pi Mainnet / Production app (real Pi)
SANDBOX=true

# Server API Key from the Pi Developer Portal / Web Console.
# NOTE: the Testnet app and the Mainnet app have DIFFERENT keys.
# Leave EMPTY to run the backend in demo mode (Pi API calls simulated).
PI_API_KEY=

# The app wallet private key is NOT used by this backend — U2A approve/complete
# only needs PI_API_KEY. This line is a placeholder for documentation only:
# keep the real key in the owner's secret store, never in a repo.
PI_WALLET_PRIVATE_KEY=

# Random string used to sign our own session tokens
SESSION_SECRET=change-me-to-a-long-random-string

# Value served at /validation-key.txt for domain ownership verification.
# (If empty, the contents of the validation-key.txt file are served instead.)
DOMAIN_VALIDATION_KEY=

# --- Agent worker LLM (lib/worker.js) ---
# Any OpenAI-compatible chat-completions endpoint. Default: Groq free tier.
# Leave LLM_API_KEY empty to run the worker with the placeholder generator.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Fallback LLM (tried when the primary fails). Default: Gemini free tier.
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_MODEL=gemini-3.8-flash
LLM_FALLBACK_TIMEOUT_MS=60000
LLM_FALLBACK_MAX_RETRIES=1
